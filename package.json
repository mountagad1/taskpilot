{
  "name": "taskpilot",
  "version": "1.1.0",
  "private": true,
  "description": "TaskPilot \u2014 The AI Operating Layer for the Browser",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@taskpilot/web",
    "build:extension": "turbo run build --filter=@taskpilot/extension",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:push": "cd supabase && supabase db push",
    "db:migrate": "cd supabase && supabase migration up",
    "db:generate": "cd supabase && supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "deploy:web": "turbo run build --filter=@taskpilot/web && vercel --prod",
    "release:extension": "turbo run build --filter=@taskpilot/extension && node scripts/package-extension.js",
    "test:watch": "vitest",
    "test:db": "vitest run --project db",
    "worker": "pnpm --filter @taskpilot/api worker",
    "dev:api": "pnpm --filter @taskpilot/api dev",
    "dev:web": "pnpm --filter @taskpilot/web dev"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
