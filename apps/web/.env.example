# ─── TaskPilot web (public frontend) ──────────────────────────────────────────
# Copy to apps/web/.env.local
#
# Since the backend split this app holds NO secrets and talks to NO database.
# It renders the marketing site and dashboard, and calls the API service for
# everything else — including authentication.

# ─── API service ──────────────────────────────────────────────────────────────
# Where services/api is running. This is the only variable the app needs.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Extension handover (optional) ────────────────────────────────────────────
# The extension ID from chrome://extensions. When set, signing in here hands
# the extension the same access token so it can call the API too.
NEXT_PUBLIC_EXTENSION_ID=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=TaskPilot
