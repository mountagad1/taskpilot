{
  "name": "@taskpilot/extension",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "package": "node scripts/build.mjs && node scripts/zip.mjs",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@taskpilot/browser-tools": "workspace:*",
    "@taskpilot/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0"
  }
}
