# ─── TaskPilot API (private backend) ──────────────────────────────────────────
# Copy to services/api/.env and fill in what you have.
#
# The service starts without any of these. Missing credentials disable the
# features that need them and return 503 `not_configured`; they never crash
# the process. `GET /health` reports which subsystems are live.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# Extra browser origins allowed to call this API, comma separated.
# taskpilot.cc, its subdomains, localhost and browser extensions are always
# allowed. Add a self-hosted dashboard origin here.
ALLOWED_ORIGINS=

# Used for Stripe redirect URLs when the request carries no Origin header.
PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: https://supabase.com/dashboard/project/<project>/settings/api
# NOTE: no NEXT_PUBLIC_ prefix — these never reach a browser. This service is
# the only thing holding them since the backend split.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# ─── AI providers ─────────────────────────────────────────────────────────────
# Either is enough. With neither, heuristic planning still works and anything
# needing a model returns a clear message.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Rate limiting and the semantic cache. Without it both fall back to
# per-process memory, which is correct but not shared across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# ─── Background worker ────────────────────────────────────────────────────────
# Shared secret for POST /v1/jobs/worker. The endpoint refuses to run without
# it, so scheduled workflows stay disabled until this is set.
# Generate with: openssl rand -hex 32
WORKER_SECRET=

# Used by `pnpm worker` (the local ticker) to reach this service.
TASKPILOT_API_URL=http://localhost:4000
WORKER_INTERVAL_MS=30000
WORKER_BATCH=10
